{
	"driver_monadolink": {
		"enable": true,
		"serial_number": "MONADOLINK-0001",
		"model_number": "Monado Link",
		"log_frames": 5,
		"quiet_logs": false,
		"openxr_runtime_json": "@MONADOLINK_OPENXR_RUNTIME_JSON@",
		"monado_runtime_file": "",
